---
// PageTitle override: renders h1 + CopyPageDropdown side by side.
import CopyPageDropdown from './CopyPageDropdown.astro';

const route = Astro.locals.starlightRoute;
const title = route.entry.data.title;
const slug = route.slug;
const mdPath = slug ? `/${slug}.md` : '/index.md';
---

<div class="page-title-row">
  <h1 id="_top">{title}</h1>
  <CopyPageDropdown mdPath={mdPath} />
</div>

<style>
  @layer starlight.core {
    h1 {
      margin-top: 1rem;
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
    }
  }

  .page-title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }
</style>
